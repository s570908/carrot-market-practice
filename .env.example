# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MySQL 데이터베이스 연결 URL (root 계정과 비밀번호, 데이터베이스 이름 포함)
DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# =============================================================================
# APPLICATION BASE CONFIGURATION
# =============================================================================
# 개발 환경에서 사용할 기본 URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# 현재 Node.js 환경 설정 (development, production, test)
NEXT_PUBLIC_NODE_ENV=development

# =============================================================================
# TMAP API CONFIGURATION
# =============================================================================
# T맵 API 키 (서버 사이드 전용)
TMAP_API_KEY=your_tmap_api_key_here
# T맵 API 키 (클라이언트 사이드에서 접근 가능)
NEXT_PUBLIC_TMAP_APP_KEY=your_tmap_public_app_key_here

# =============================================================================
# PUSH NOTIFICATION CONFIGURATION
# =============================================================================
# VAPID 공개키 (웹 푸시 알림용, 클라이언트에서 접근 가능)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# VAPID 개인키 (웹 푸시 알림용, 서버 전용)
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# VAPID 주제 (이메일 주소 형식)
VAPID_SUBJECT=mailto:your-email@example.com
# 만료된 푸시 구독 자동 삭제 여부 (true/false)
AUTO_DELETE_EXPIRED_SUBSCRIPTIONS=true
# 유효하지 않은 푸시 구독 자동 삭제 여부 (true/false)
AUTO_DELETE_INVALID_SUBSCRIPTIONS=true
# 관리자 API 접근을 위한 키
ADMIN_API_KEY=your_admin_secret_key_here
# 크론 작업 API 접근을 위한 키
CRON_API_KEY=your_cron_secret_key_here

# =============================================================================
# TWILIO SMS CONFIGURATION
# =============================================================================
# Twilio 계정 SID
TWILIO_SID=your_twilio_sid_here
# Twilio 인증 토큰
TWILIO_TOKEN=your_twilio_token_here
# Twilio 메시징 서비스 SID
TWILIO_MSID=your_twilio_messaging_sid_here
# Twilio에서 사용할 발신 전화번호
TWILIO_PHONE=+1234567890
# 개발자 개인 전화번호 (테스트용)
MY_PHONE=+821234567890

# =============================================================================
# EMAIL SERVICE CONFIGURATION
# =============================================================================
# Mailgun API 키 (이메일 발송 서비스)
MAILGUN_API_KEY=your_mailgun_api_key_here
# Mailgun 도메인
MAILGUN_DOMAIN=your_mailgun_domain_here
# SendGrid API 키 (대체 이메일 서비스)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# 세션 쿠키 암호화용 비밀번호 (32자 이상의 강력한 비밀번호 권장)
# 특수문자가 포함된 경우 큰따옴표로 감싸주세요
COOKIE_PASSWORD="your_very_secure_cookie_password_here"

# =============================================================================
# CLOUDFLARE CONFIGURATION
# =============================================================================
# Cloudflare 계정 ID
CF_ID=your_cloudflare_account_id_here
# Cloudflare Images API 토큰
CF_IMAGE_TOKEN=your_cloudflare_image_token_here
# Cloudflare Stream API 토큰
CF_STREAM_TOKEN=your_cloudflare_stream_token_here
# Cloudflare 해시 (클라이언트에서 접근 가능)
NEXT_PUBLIC_CF_HASH=your_cloudflare_hash_here
# Cloudflare 계정 ID (철자 확인용)
CLOUDFARE_ACCOUNT_ID=your_cloudflare_account_id_here
# Cloudflare Images 토큰 (대체)
CLOUDFARE_IMAGE_TOKEN=your_cloudflare_image_token_here
# Cloudflare Stream 토큰 (대체)
CLOUDFARE_STREAM_TOKEN=your_cloudflare_stream_token_here
# Cloudflare 글로벌 API 토큰
CLOUDFLARE_GLOBAL_TOKEN=your_cloudflare_global_token_here

# =============================================================================
# CLOUDINARY CONFIGURATION
# =============================================================================
# Cloudinary API 키 (이미지 저장소)
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
# Cloudinary 업로드 엔드포인트 URL
CLOUDINARY_STORAGE=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
# Cloudinary 업로드 프리셋
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_preset_here

# =============================================================================
# API URL CONFIGURATION (선택사항)
# =============================================================================
# 외부 API 기본 URL (필요한 경우에만 설정)
NEXT_PUBLIC_API_URL=

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. 이 파일을 복사하여 .env.local로 이름을 변경하고 실제 값을 입력하세요
# 2. .env.local 파일은 절대 Git에 커밋하지 마세요 (.gitignore에 추가되어야 함)
# 3. 프로덕션 환경에서는 환경별로 다른 값을 사용해야 합니다
# 4. API 키와 비밀번호는 주기적으로 변경하는 것을 권장합니다
# 5. NEXT_PUBLIC_ 접두사가 있는 변수만 클라이언트에서 접근 가능합니다